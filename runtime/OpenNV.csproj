<Project Sdk="Godot.NET.Sdk/4.8.0-dev.7">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OpenNV</AssemblyName>
    <RootNamespace>OpenNV</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-default</AnalysisLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Compile the Windows release export ahead of gameplay to reduce cold
         action JIT work. Keep IL for runtime fallback; this is not NativeAOT. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'ExportRelease' and '$(RuntimeIdentifier)' == 'win-x64'">true</PublishReadyToRun>
  </PropertyGroup>
  <!-- iOS requires NativeAOT. The runtime serializes saves and state with
       reflection-based System.Text.Json, so keep that serializer enabled and
       root this assembly's metadata instead of failing on trim analysis. -->
  <PropertyGroup Condition="'$(GodotTargetPlatform)' == 'ios'">
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);IL2026;IL2075;IL2104;IL3000;IL3050;IL3053</NoWarn>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <SuppressAotAnalysisWarnings>true</SuppressAotAnalysisWarnings>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <!-- iOS caps per-app memory and address space; skip the background GC's
         extra reservation. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup Condition="'$(GodotTargetPlatform)' == 'ios'">
    <TrimmerRootAssembly Include="$(AssemblyName)" />
    <!-- Generated by scripts/ios/JsonAotDirectives: pre-instantiates the
         System.Text.Json converters NativeAOT cannot create at runtime. -->
    <RdXmlFile Include="ios/OpenNV.Json.rd.xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools\OpenNV.ResourceProbe\**\*.cs" />
    <Compile Remove="tools\NativeStackStartupAudit\**\*.cs" />
    <Compile Remove="tools\ParityRetailPublisher\**\*.cs" />
    <Compile Remove="tools\ParityLiveComparator\**\*.cs" />
  </ItemGroup>
</Project>
